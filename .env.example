# Copy to .env.local for `npm run dev`. Never put Spotify keys here: they live only in the Worker.
# Address of the Spotify "now playing" Worker (no trailing slash). Leave empty to hide the card.
NEXT_PUBLIC_SPOTIFY_NOW_PLAYING_URL=
# Address of the CV request Worker (no trailing slash). Leave empty to hide "Request CV".
NEXT_PUBLIC_CV_API_URL=
# Optional Cloudflare Turnstile site key (public). Leave empty to skip Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
